{
  "id": "low_vision",
  "args": [
    {
      "name": "avoid_unpaved",
      "type": "bool",
      "default": true,
      "description": "Treat unpaved surfaces as impassable (unstable footing, no tactile guiding)."
    },
    {
      "name": "heat_aware",
      "type": "bool",
      "default": false,
      "description": "Weight edges by mean radiant temperature. False reproduces the pre-thermal router exactly."
    },
    {
      "name": "mrt_warm",
      "type": "float",
      "default": 35.0,
      "description": "Mean radiant temperature (C) above which an edge starts costing more. Comfort threshold."
    },
    {
      "name": "mrt_hot",
      "type": "float",
      "default": 42.0,
      "description": "MRT (C) above which sustained walking is uncomfortable for a healthy adult."
    },
    {
      "name": "mrt_severe",
      "type": "float",
      "default": 50.0,
      "description": "MRT (C) at which heat strain becomes a health risk over a several-minute exposure."
    },
    {
      "name": "mrt_extreme",
      "type": "float",
      "default": 58.0,
      "description": "MRT (C) of fully sun-exposed asphalt at a July afternoon peak. Avoid where any alternative exists."
    }
  ],
  "cost": {
    "impassable_if": [
      {
        "all": [
          {
            "param": "avoid_unpaved",
            "op": "eq",
            "value": true
          },
          {
            "attr": "surface",
            "op": "in",
            "value": [
              "unpaved",
              "gravel",
              "dirt",
              "grass",
              "mud",
              "sand"
            ]
          }
        ]
      }
    ],
    "base": "length",
    "multipliers": [
      {
        "description": "Rough stone surfaces increase effective cost by 50%.",
        "if": {
          "attr": "surface",
          "op": "in",
          "value": [
            "cobblestone",
            "sett",
            "unhewn_cobblestone"
          ]
        },
        "multiply": 1.5
      },
      {
        "description": "Zebra crossings are most visible \u2014 preferred.",
        "if": {
          "attr": "crossing_markings",
          "op": "eq",
          "value": "zebra"
        },
        "multiply": 0.8
      },
      {
        "description": "Unknown-marking crossings may be unmarked \u2014 penalised.",
        "if": {
          "attr": "crossing_markings",
          "op": "eq",
          "value": "unknown"
        },
        "multiply": 1.5
      },
      {
        "description": "Above the comfort threshold. A mild preference for the shaded side of the street.",
        "if": {
          "all": [
            {
              "param": "heat_aware",
              "op": "eq",
              "value": true
            },
            {
              "attr": "mrt",
              "op": "gt",
              "param": "mrt_warm"
            }
          ]
        },
        "multiply": 1.15
      },
      {
        "description": "Compounds with the warm band. Uncomfortable for sustained walking.",
        "if": {
          "all": [
            {
              "param": "heat_aware",
              "op": "eq",
              "value": true
            },
            {
              "attr": "mrt",
              "op": "gt",
              "param": "mrt_hot"
            }
          ]
        },
        "multiply": 1.3
      },
      {
        "description": "Compounds again. Heat strain over a several-minute exposure.",
        "if": {
          "all": [
            {
              "param": "heat_aware",
              "op": "eq",
              "value": true
            },
            {
              "attr": "mrt",
              "op": "gt",
              "param": "mrt_severe"
            }
          ]
        },
        "multiply": 1.5
      },
      {
        "description": "Compounds again. Fully sun-exposed surface at peak. 3.92x in total.",
        "if": {
          "all": [
            {
              "param": "heat_aware",
              "op": "eq",
              "value": true
            },
            {
              "attr": "mrt",
              "op": "gt",
              "param": "mrt_extreme"
            }
          ]
        },
        "multiply": 1.75
      }
    ]
  }
}
